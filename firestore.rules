rules_version = '2';

// Each signed-in person can read and write only their own document, users/{their uid}.
// Everything else is closed. (The evening-reminder job uses an admin key and isn't bound by these.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['goals', 'tasks', 'routines', 'screen', 'expenses', 'pool', 'areas', 'income', 'events', 'notes',
              'aims', 'budgets', 'equbs', 'debts', 'people', 'fasts',
              'updated', 'reminder', 'lastReminder', 'telegram'])
        && (!('goals' in request.resource.data) || request.resource.data.goals.size() <= 200)
        && (!('tasks' in request.resource.data) || request.resource.data.tasks.size() <= 5000)
        && (!('routines' in request.resource.data) || request.resource.data.routines.size() <= 200)
        && (!('screen' in request.resource.data) || request.resource.data.screen.size() <= 2000)
        && (!('expenses' in request.resource.data) || request.resource.data.expenses.size() <= 5000)
        && (!('pool' in request.resource.data) || request.resource.data.pool.size() <= 2000)
        && (!('areas' in request.resource.data) || request.resource.data.areas.size() <= 300)
        && (!('income' in request.resource.data) || request.resource.data.income.size() <= 5000)
        && (!('events' in request.resource.data) || request.resource.data.events.size() <= 1000)
        && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 2000)
        && (!('aims' in request.resource.data) || request.resource.data.aims.size() <= 300)
        && (!('budgets' in request.resource.data) || request.resource.data.budgets.size() <= 100)
        && (!('equbs' in request.resource.data) || request.resource.data.equbs.size() <= 100)
        && (!('debts' in request.resource.data) || request.resource.data.debts.size() <= 1000)
        && (!('people' in request.resource.data) || request.resource.data.people.size() <= 500)
        && (!('fasts' in request.resource.data) || request.resource.data.fasts.size() <= 2000)
        // The page may only set a link code; the bot job (admin key) fills in the chat.
        && (!('telegram' in request.resource.data)
            || request.resource.data.telegram == resource.data.get('telegram', null)
            || request.resource.data.telegram.keys().hasOnly(['code']));
    }
  }
}
